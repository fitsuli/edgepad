# Slot 0 starts on the left edge together with slot 1 in the center. Edge
# gestures are one-finger only, so both pass through as a two-finger gesture.
ABS_MT_SLOT 0
ABS_MT_TRACKING_ID 100
ABS_MT_POSITION_X 20
ABS_MT_POSITION_Y 300
ABS_MT_SLOT 1
ABS_MT_TRACKING_ID 200
ABS_MT_POSITION_X 500
ABS_MT_POSITION_Y 300
SYN_REPORT 0

ABS_MT_SLOT 0
ABS_MT_POSITION_X 220
ABS_MT_POSITION_Y 310
ABS_MT_SLOT 1
ABS_MT_POSITION_X 510
ABS_MT_POSITION_Y 310
SYN_REPORT 16000

ABS_MT_SLOT 0
ABS_MT_TRACKING_ID -1
ABS_MT_SLOT 1
ABS_MT_TRACKING_ID -1
SYN_REPORT 32000
